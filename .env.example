# Copy to .env (cp .env.example .env). Docker Compose reads it automatically.
# Everything works without this file: mock models are on by default.

# ---- App ----
APP_ENV=dev
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Models ----
# true  = fake but deterministic model answers (no keys needed, great for UI work)
# false = call the real Meta endpoints below
MOCK_MODELS=true

# Meta model API (adapt names to the hackathon docs, see backend/app/services/models/meta.py)
META_API_BASE=
META_API_KEY=
META_SEGMENT_MODEL=sam-3.1
META_LABEL_MODEL=muse-image
META_REASON_MODEL=muse-spark

# Open-weights vision model on Baseten or Modal (used for audit judging)
VISION_LLM_URL=
VISION_LLM_KEY=

# ---- Pipeline tuning ----
FRAMES_PER_SECOND=2
MAX_FRAMES_PER_ROOM=40
MAX_SEGMENTS_PER_IMAGE=20
MIN_MISSING_CONFIDENCE=0.7
MIN_MISPLACED_CONFIDENCE=0.6
